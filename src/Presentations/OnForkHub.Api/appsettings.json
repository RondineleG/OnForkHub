{
    "Logging": {
        "LogLevel": {
            "Default": "Information",
            "Microsoft.AspNetCore": "Warning"
        }
    },
    "AllowedHosts": "*",
    "FileStorage": {
        "BasePath": "uploads",
        "BaseUrl": "/files",
        "ServePublicVideos": false
    },
    "Jwt": {
        "Issuer": "OnForkHub.Api",
        "Audience": "OnForkHub.Client",
        "ValidateIssuer": true,
        "ValidateAudience": true,
        "ValidateLifetime": true,
        "ValidateIssuerSigningKey": true,
        "AccessTokenExpirationMinutes": 60,
        "RefreshTokenExpirationDays": 7
    },
    "Cache": {
        "UseRedis": false,
        "RedisConnectionString": "",
        "InstanceName": "OnForkHub_",
        "DefaultExpirationMinutes": 30
    },
    "RateLimiting": {
        "Enabled": true,
        "PermitLimit": 100,
        "WindowSeconds": 60,
        "QueueLimit": 10,
        "AuthenticatedPermitLimit": 500,
        "AnonymousPermitLimit": 50,
        "AuthPermitLimitPerMinute": 10
    }
}
