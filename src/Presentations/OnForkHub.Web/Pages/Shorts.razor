@page "/"
@using System.Globalization
@implements IAsyncDisposable
@inject IJSRuntime JS

<PageTitle>OnForkHub</PageTitle>

@* Static markup: shortsFeed.js owns playback state, so updates never trigger Blazor renders.
   Built from the OnForkHub DS (css/ofh.css). The rail and the info sit beside the frame so the desktop can lay them out
   next to and under the video; on phones and in full screen they are laid over it. *@
<div class="feed is-muted" @ref="_feed">
    <header class="feed-top">
        <div class="ofh-brand">
            <BrandMark />
            <BrandWordmark />
        </div>
        <button type="button" class="ofh-icon-btn ofh-icon-btn--ghost feed-theme" aria-label="Alternar tema claro e escuro">
            <Icon Name="sun" Size="24" class="icon-sun" />
            <Icon Name="moon" Size="22" class="icon-moon" />
        </button>
    </header>

    <nav class="feed-nav" aria-label="Navegar entre vídeos">
        <button type="button" class="ofh-icon-btn feed-prev" aria-label="Vídeo anterior">
            <Icon Name="chevron-up" Size="24" />
        </button>
        <button type="button" class="ofh-icon-btn feed-next" aria-label="Próximo vídeo">
            <Icon Name="chevron-down" Size="24" />
        </button>
    </nav>

    <main class="shorts" aria-label="Vídeos">
        @for (var i = 0; i < ShortsCatalog.Videos.Count; i++)
        {
            var video = ShortsCatalog.Videos[i];
            <article class="short" data-index="@i" data-source="@video.TorrentUrl" data-state="idle" aria-label="@video.Title">
                <div class="short-frame">
                    <canvas class="short-ambient" width="18" height="32" aria-hidden="true"></canvas>
                    <div class="short-media" id="short-media-@i"></div>
                    <div class="short-shade" aria-hidden="true"></div>
                    <div class="short-gesture" aria-hidden="true"></div>

                    <div class="short-loading" aria-hidden="true">
                        <BrandSpinner />
                        <span class="ofh-meta short-loading-status"></span>
                    </div>

                    <div class="short-paused" aria-hidden="true">
                        <span class="ofh-icon-btn short-center-icon">
                            <Icon Name="play" Size="36" />
                        </span>
                    </div>

                    <div class="short-flash" aria-hidden="true">
                        <span class="ofh-icon-btn short-center-icon">
                            <Icon Name="play" Size="30" class="icon-play" />
                            <Icon Name="pause" Size="30" class="icon-pause" />
                        </span>
                    </div>

                    <div class="short-seek" data-direction="-1" aria-hidden="true">
                        <Icon Name="rewind" Size="28" />
                        <span class="short-seek-label ofh-meta"></span>
                    </div>
                    <div class="short-seek" data-direction="1" aria-hidden="true">
                        <Icon Name="forward" Size="28" />
                        <span class="short-seek-label ofh-meta"></span>
                    </div>

                    <div class="ofh-pill short-boost" aria-hidden="true">2× ▸▸</div>

                    <div class="short-error" role="status">
                        <span class="ofh-meta">Não foi possível carregar este vídeo</span>
                        <button type="button" class="btn btn-secondary btn-sm short-retry">Tentar de novo</button>
                    </div>

                    <button type="button" class="ofh-pill short-unmute">
                        <Icon Name="volume-off" Size="16" />
                        <span>Ativar o som</span>
                    </button>

                    <div class="short-scrub" role="slider" aria-label="Posição do vídeo" aria-valuemin="0" aria-valuemax="100" aria-valuenow="0">
                        <span class="ofh-pill short-time"></span>
                        <div class="short-track">
                            <div class="short-buffer"></div>
                            <div class="short-fill"></div>
                            <div class="short-thumb"></div>
                        </div>
                    </div>
                </div>

                <div class="short-rail">
                    <button type="button" class="ofh-action short-sound" aria-label="Ativar som">
                        <span class="ofh-action-icon">
                            <Icon Name="volume-off" Size="22" class="icon-muted" />
                            <Icon Name="volume-on" Size="22" class="icon-sound" />
                        </span>
                        <span class="ofh-action-label"><span class="icon-muted">Mudo</span><span class="icon-sound">Som</span></span>
                    </button>
                    <button type="button" class="ofh-action short-settings" aria-label="Ajustes de reprodução">
                        <span class="ofh-action-icon">
                            <Icon Name="gauge" Size="22" />
                        </span>
                        <span class="ofh-action-label short-rate-label">1×</span>
                    </button>
                    <button type="button" class="ofh-action short-fullscreen" aria-label="Tela cheia">
                        <span class="ofh-action-icon">
                            <Icon Name="expand" Size="22" class="icon-expand" />
                            <Icon Name="collapse" Size="22" class="icon-collapse" />
                        </span>
                        <span class="ofh-action-label"><span class="icon-expand">Tela</span><span class="icon-collapse">Sair</span></span>
                    </button>
                </div>

                <div class="short-info">
                    <span class="ofh-credit">@video.Credit</span>
                    <h2 class="ofh-title short-title">@video.Title</h2>
                    <p class="ofh-body short-description">@video.Description</p>
                    <span class="ofh-meta ofh-live short-stats"></span>
                </div>
            </article>
        }
    </main>

    <div class="sheet" aria-hidden="true">
        <div class="sheet-backdrop"></div>
        <div class="ofh-sheet sheet-panel" role="dialog" aria-label="Ajustes de reprodução">
            <div class="ofh-sheet-handle"></div>

            <section class="ofh-field">
                <span class="ofh-eyebrow">Velocidade</span>
                <div class="ofh-segmented">
                    @foreach (var rate in PlaybackRates)
                    {
                        <button type="button" class="ofh-chip" data-rate="@rate.ToString(CultureInfo.InvariantCulture)">@FormatRate(rate)</button>
                    }
                </div>
            </section>

            <section class="ofh-field sheet-volume">
                <span class="ofh-eyebrow">Volume</span>
                <div class="sheet-volume-row">
                    <button type="button" class="ofh-icon-btn ofh-icon-btn--sm sheet-mute" aria-label="Ativar som">
                        <Icon Name="volume-off" Size="20" class="icon-muted" />
                        <Icon Name="volume-on" Size="20" class="icon-sound" />
                    </button>
                    <input type="range" class="ofh-range sheet-range" min="0" max="1" step="0.05" value="1" aria-label="Volume" />
                </div>
            </section>

            <section class="ofh-field">
                <span class="ofh-eyebrow">Enquadramento</span>
                <div class="ofh-segmented">
                    <button type="button" class="ofh-chip" data-fit="cover">Preencher</button>
                    <button type="button" class="ofh-chip" data-fit="contain">Inteiro</button>
                </div>
            </section>
        </div>
    </div>
</div>

@code {
    private static readonly double[] PlaybackRates = [0.5, 0.75, 1, 1.25, 1.5, 2];

    private ElementReference _feed;

    private IJSObjectReference? _module;

    public async ValueTask DisposeAsync()
    {
        if (_module is null)
        {
            return;
        }

        try
        {
            await _module.InvokeVoidAsync("disposeShortsFeed");
            await _module.DisposeAsync();
        }
        catch (JSDisconnectedException)
        {
            // The browser is already gone; nothing left to release.
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        _module = await JS.InvokeAsync<IJSObjectReference>("import", "./js/shortsFeed.js");
        await _module.InvokeVoidAsync("initShortsFeed", _feed);
    }

    private static string FormatRate(double rate) => rate.ToString("0.##", CultureInfo.InvariantCulture) + "×";
}
