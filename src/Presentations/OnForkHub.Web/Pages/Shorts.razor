@page "/"
@implements IAsyncDisposable
@inject IJSRuntime JS

<PageTitle>OnForkHub</PageTitle>

<div class="grain" aria-hidden="true"></div>

@* Static markup: shortsFeed.js owns playback state, so updates never trigger Blazor renders. *@
<main class="shorts" @ref="_feed" aria-label="Vídeos">
    @for (var i = 0; i < ShortsCatalog.Videos.Count; i++)
    {
        var video = ShortsCatalog.Videos[i];
        <article class="short" data-index="@i" data-source="@video.TorrentUrl" data-state="idle" aria-label="@video.Title">
            <div class="short-frame">
                <div class="short-media" id="short-media-@i"></div>

                <div class="short-loading" aria-hidden="true">
                    <div class="spinner">
                        <div class="spinner-ring"></div>
                        <div class="spinner-ring"></div>
                        <div class="spinner-sweep"></div>
                        <div class="spinner-icon">✦</div>
                    </div>
                </div>

                <div class="short-paused" aria-hidden="true">
                    <svg viewBox="0 0 24 24" width="56" height="56"><path fill="currentColor" d="M8 5v14l11-7z" /></svg>
                </div>

                <div class="short-error" role="status">
                    <span class="t-mono">Não foi possível carregar este vídeo</span>
                    <button type="button" class="btn btn-secondary btn-sm short-retry">Tentar de novo</button>
                </div>

                <button type="button" class="btn-icon short-sound" aria-label="Ativar som">
                    <svg class="icon-muted" viewBox="0 0 24 24" width="18" height="18"><path fill="currentColor" d="M3 9v6h4l5 5V4L7 9H3zm13.6 3 2.7-2.7-1.4-1.4-2.7 2.7-2.7-2.7-1.4 1.4 2.7 2.7-2.7 2.7 1.4 1.4 2.7-2.7 2.7 2.7 1.4-1.4z" /></svg>
                    <svg class="icon-sound" viewBox="0 0 24 24" width="18" height="18"><path fill="currentColor" d="M3 9v6h4l5 5V4L7 9H3zm13.5 3A4.5 4.5 0 0 0 14 8v8a4.5 4.5 0 0 0 2.5-4zM14 3.2v2.1a7 7 0 0 1 0 13.4v2.1a9 9 0 0 0 0-17.6z" /></svg>
                </button>

                <div class="short-info">
                    <span class="t-eyebrow">@video.Credit</span>
                    <h2 class="short-title">@video.Title</h2>
                    <p class="short-description">@video.Description</p>
                    <span class="short-stats t-mono-sm"></span>
                </div>

                <div class="short-progress"><div class="short-progress-fill"></div></div>
            </div>
        </article>
    }
</main>

@code {
    private ElementReference _feed;

    private IJSObjectReference? _module;

    public async ValueTask DisposeAsync()
    {
        if (_module is null)
        {
            return;
        }

        try
        {
            await _module.InvokeVoidAsync("disposeShortsFeed");
            await _module.DisposeAsync();
        }
        catch (JSDisconnectedException)
        {
            // The browser is already gone; nothing left to release.
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        _module = await JS.InvokeAsync<IJSObjectReference>("import", "./js/shortsFeed.js");
        await _module.InvokeVoidAsync("initShortsFeed", _feed);
    }
}
