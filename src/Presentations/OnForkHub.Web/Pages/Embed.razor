@page "/embed/{Id}"
@inject IVideoService VideoService

<PageTitle>Embed - OnForkHub</PageTitle>

@if (video != null)
{
    <HeadContent>
        <meta name="robots" content="noindex" />
    </HeadContent>
}

<div class="embed-player">
    @if (isLoading)
    {
        <BrandSpinner role="status" aria-label="Carregando" />
    }
    else if (video == null)
    {
        <span class="t-mono">Vídeo não encontrado</span>
    }
    else
    {
        <AdaptiveVideoPlayer ManifestUrl="@($"/api/v1/videos/{video.Id}/stream/manifest.mpd")" AutoPlay="false" />

        <a href="/" target="_blank" class="embed-link t-mono-sm">Assistir no OnForkHub ↗</a>
    }
</div>

@code {
    [Parameter] public string Id { get; set; } = string.Empty;

    private OnForkHub.Web.Models.Video? video;
    private bool isLoading = true;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            isLoading = true;
            video = await VideoService.GetVideoByIdAsync(Id);
        }
        catch
        {
            video = null;
        }
        finally
        {
            isLoading = false;
        }
    }
}
