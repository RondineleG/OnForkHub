@inject IJSRuntime JSRuntime
@implements IAsyncDisposable

<div id="@containerId" class="adaptive-player">
    <video id="@playerId" controls class="adaptive-player-video"></video>

    @if (isLoading)
    {
        <div class="adaptive-player-loading" role="status" aria-label="Carregando player">
            <div class="spinner">
                <div class="spinner-ring"></div>
                <div class="spinner-ring"></div>
                <div class="spinner-sweep"></div>
                <div class="spinner-icon">✦</div>
            </div>
        </div>
    }

    <div id="@statsId" class="adaptive-player-stats t-mono-sm"></div>
</div>

@code {
    [Parameter] public string ManifestUrl { get; set; } = string.Empty;
    [Parameter] public bool AutoPlay { get; set; } = true;

    private string containerId = $"dash-container-{Guid.NewGuid():N}";
    private string playerId = $"dash-player-{Guid.NewGuid():N}";
    private string statsId = $"dash-stats-{Guid.NewGuid():N}";
    private bool isLoading = true;
    private IJSObjectReference? _module;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && !string.IsNullOrEmpty(ManifestUrl))
        {
            await InitializePlayerAsync();
        }
    }

    private async Task InitializePlayerAsync()
    {
        try
        {
            isLoading = true;
            _module = await JSRuntime.InvokeAsync<IJSObjectReference>("import", "./js/dashPlayer.js");
            await _module.InvokeVoidAsync("initializePlayer", playerId, ManifestUrl, AutoPlay, statsId);
            isLoading = false;
            StateHasChanged();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error initializing DASH player: {ex.Message}");
            isLoading = false;
            StateHasChanged();
        }
    }

    public async ValueTask DisposeAsync()
    {
        if (_module != null)
        {
            try
            {
                await _module.InvokeVoidAsync("destroyPlayer", playerId);
                await _module.DisposeAsync();
            }
            catch { }
        }
    }
}
