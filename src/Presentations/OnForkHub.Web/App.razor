<Router AppAssembly="@typeof(App).Assembly">
    <Found Context="routeData">
        <RouteView RouteData="@routeData" DefaultLayout="@typeof(BlankLayout)" />
        <FocusOnNavigate RouteData="@routeData" Selector="h1" />
    </Found>
    <NotFound>
        <PageTitle>Página não encontrada</PageTitle>
        <LayoutView Layout="@typeof(BlankLayout)">
            <div class="page-empty">
                <span class="t-eyebrow">404</span>
                <h1 class="t-h1">Página não encontrada</h1>
                <a href="/" class="btn btn-primary">Voltar aos vídeos</a>
            </div>
        </LayoutView>
    </NotFound>
</Router>
