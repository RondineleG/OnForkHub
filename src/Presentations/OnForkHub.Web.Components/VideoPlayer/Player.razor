@using OnForkHub.Web.Components.Models
@using Microsoft.AspNetCore.Components
@inject IJSRuntime JSRuntime

<HeadContent>
    <link rel="stylesheet" href="/_content/OnForkHub.Web.Components/plyr.css" />
    <script src="https://cdn.jsdelivr.net/webtorrent/latest/webtorrent.min.js"></script>
</HeadContent>

@if (!string.IsNullOrEmpty(MagnetUri) || !string.IsNullOrEmpty(TorrentFilePath) || EnableTorrentFileUpload)
{
    var showPlaceholder = TorrentState == ETorrentState.Idle && string.IsNullOrEmpty(MagnetUri);

    <div class="w-100">
        @if (EnableTorrentFileUpload)
        {
            <div class="d-flex align-items-center gap-3 mb-3">
                <label for="torrent-file-@InputAttributes["id"]" class="btn btn-primary mb-0 text-nowrap">
                    <i class="bi bi-folder2-open me-1"></i> Escolher arquivo .torrent
                </label>
                <input type="file" accept=".torrent" id="torrent-file-@InputAttributes["id"]" class="d-none" @onchange="HandleTorrentFile" />
                <span class="text-muted text-truncate">@(string.IsNullOrEmpty(TorrentFileName) ? "Nenhum arquivo selecionado" : TorrentFileName)</span>
            </div>
        }

        <div class="position-relative rounded overflow-hidden bg-black" style="min-height: 400px;">
            @* The element with the player id is owned by JavaScript: Blazor never renders children inside it. *@
            <div id="@InputAttributes["id"]"></div>

            @if (showPlaceholder)
            {
                <div class="position-absolute top-0 start-0 w-100 h-100 d-flex flex-column align-items-center justify-content-center text-white-50">
                    <i class="bi bi-film fs-1 mb-2"></i>
                    <span>Escolha um arquivo .torrent para começar</span>
                    <small class="mt-1">O vídeo começa a tocar assim que os primeiros pedaços chegam.</small>
                </div>
            }

            @if (TorrentState == ETorrentState.Error)
            {
                <div class="position-absolute top-0 start-0 w-100 h-100 d-flex flex-column align-items-center justify-content-center bg-black text-white p-4 text-center">
                    <i class="bi bi-exclamation-triangle fs-1 text-warning mb-2"></i>
                    <span>@ErrorMessage</span>
                </div>
            }
        </div>

        @if (TorrentState is ETorrentState.Connecting or ETorrentState.Playing or ETorrentState.Completed)
        {
            <div class="mt-2">
                <div class="progress" style="height: 4px;">
                    <div class="progress-bar @(TorrentState == ETorrentState.Completed ? "bg-success" : string.Empty)"
                         role="progressbar"
                         style="width: @(TorrentProgress)%"
                         aria-valuenow="@TorrentProgress"
                         aria-valuemin="0"
                         aria-valuemax="100"></div>
                </div>
                <div class="d-flex justify-content-between small text-muted mt-1">
                    <span>
                        @switch (TorrentState)
                        {
                            case ETorrentState.Connecting:
                                <text><span class="spinner-border spinner-border-sm me-1" aria-hidden="true"></span> Conectando aos peers...</text>
                                break;
                            case ETorrentState.Playing:
                                <text><i class="bi bi-play-circle me-1"></i> Reproduzindo enquanto baixa</text>
                                break;
                            default:
                                <text><i class="bi bi-check-circle text-success me-1"></i> Download completo</text>
                                break;
                        }
                    </span>
                    <span>
                        @TorrentProgress% · @TorrentPeers @(TorrentPeers == 1 ? "peer" : "peers")
                        @if (TorrentState != ETorrentState.Completed)
                        {
                            <text> · @FormatSpeed(TorrentDownloadSpeed)</text>
                        }
                    </span>
                </div>
            </div>
        }
    </div>
}
else if (Sources?.Any() == true)
{
    <video controls poster="@Poster" @attributes="InputAttributes" style="border-radius: 8px; overflow: hidden;">
        @foreach (var source in Sources)
        {
            <source src="@source.Src" type="@source.Type" />
        }
        @if (Tracks != null)
        {
            foreach (var track in Tracks)
            {
                if (track.IsDefault)
                {
                    <track kind="@track.Kind" label="@track.Label" src="@track.Src" srclang="@track.SrcLang" default />
                }
                else
                {
                    <track kind="@track.Kind" label="@track.Label" src="@track.Src" srclang="@track.SrcLang" />
                }
            }
        }
    </video>
}
else
{
    <div style="padding: 40px; text-align: center; color: #6c757d; border: 2px dashed #dee2e6; border-radius: 8px; background-color: #f8f9fa;">
        <div style="font-size: 48px; margin-bottom: 15px;">📺</div>
        <div style="font-size: 18px; font-weight: 500; margin-bottom: 5px;">Nenhuma fonte de vídeo encontrada</div>
        <div style="font-size: 14px;">Configure uma fonte de vídeo, magnet URI ou habilite upload de torrents</div>
    </div>
}
